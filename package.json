{
  "name": "immerslides",
  "version": "1.0.0-beta-2",
  "description": "React presentations with immersive code and flow walkthroughs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "immerslides": "./bin/immerslides.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./player": {
      "types": "./dist/presentation/Player.d.ts",
      "import": "./dist/presentation/Player.js"
    },
    "./site": {
      "types": "./dist/site/index.d.ts",
      "import": "./dist/site/index.js"
    },
    "./slide-navigator": {
      "types": "./dist/presentation/SlideNavigator.d.ts",
      "import": "./dist/presentation/SlideNavigator.js"
    },
    "./slide-preview": {
      "types": "./dist/presentation/SlidePreview.d.ts",
      "import": "./dist/presentation/SlidePreview.js"
    },
    "./slide-frame": {
      "types": "./dist/slides/SlideFrame.d.ts",
      "import": "./dist/slides/SlideFrame.js"
    },
    "./chapter-guide": {
      "types": "./dist/slides/ChapterGuide.d.ts",
      "import": "./dist/slides/ChapterGuide.js"
    },
    "./code-block": {
      "types": "./dist/code/CodeBlock.d.ts",
      "import": "./dist/code/CodeBlock.js"
    },
    "./code-window": {
      "types": "./dist/code/CodeWindow.d.ts",
      "import": "./dist/code/CodeWindow.js"
    },
    "./highlighted-code": {
      "types": "./dist/code/HighlightedCode.d.ts",
      "import": "./dist/code/HighlightedCode.js"
    },
    "./timeline": {
      "types": "./dist/flow/Timeline.d.ts",
      "import": "./dist/flow/Timeline.js"
    },
    "./flow-node": {
      "types": "./dist/flow/FlowNode.d.ts",
      "import": "./dist/flow/FlowNode.js"
    },
    "./flow-connector": {
      "types": "./dist/flow/FlowConnector.d.ts",
      "import": "./dist/flow/FlowConnector.js"
    },
    "./step-description": {
      "types": "./dist/walkthrough/StepDescription.d.ts",
      "import": "./dist/walkthrough/StepDescription.js"
    },
    "./deck": {
      "types": "./dist/presentation/types.d.ts",
      "import": "./dist/presentation/types.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "starter/.nvmrc",
    "starter/index.html",
    "starter/package.json",
    "starter/public",
    "starter/site",
    "starter/slides",
    "starter/src",
    "starter/tsconfig.json",
    "starter/vite.config.ts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write . --error-on-warnings",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "avvvatars-react": "0.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.20.0"
}
